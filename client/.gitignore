.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 日志 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Lint / 测试缓存 ----------
.eslintcache
coverage/

# ---------- 临时 ----------
*.tmp
*.tmpdir/