# ============================================================
# server · 后端（Express + node:sqlite + Socket.IO）
# ============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 数据库（真实数据，绝不入库）----------
chat.db
chat.db-journal
chat.db-wal
chat.db-shm
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- 本地配置（含 JWT 密钥 / 端口 / 私有白名单）----------
# config.yaml 入库（默认配置），config.local.yaml 不入库（个人覆写）
config.local.yaml
config.local.yml
*.local.yaml
*.local.yml

# ---------- 上传目录：完全忽略 ----------
# 目录由服务端启动时 mkdirSync(recursive) 自动创建，不在仓库里留任何占位文件。
# （历史上靠 .gitkeep 占位，现在改为运行时生成。前提：src/config.js / index.js
#   启动处已有 mkdirSync 兜底，见 DEVLOG §0 部署形态与 §1.50 同类教训。）
uploads/

# ---------- 测试临时目录（只匹配 server 根下，不下钻）----------
/tmp/
/temp/
/.tmp/

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- 备份 / 临时 ----------
*.bak
*.backup
*.orig
*~
*.tmp
*.tmpdir/
*.pid

# ---------- 编辑器 ----------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------- 覆盖率 ----------
coverage/
.nyc_output/